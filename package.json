{
  "name": "herdr-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "backend": "pnpm --filter backend",
    "web": "pnpm --filter web",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:agents": "turbo run build --filter=backend... && pnpm --filter @herdr-web/agents test:live && pnpm --filter web test:live"
  },
  "devDependencies": {
    "pi-ask-user": "github:Trex-Hub/pi-ask-user#2a1c80d",
    "pi-live": "github:Trex-Hub/pi-live#62871ee",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
